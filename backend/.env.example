NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5000
TRUST_PROXY_HOPS=0
RATE_LIMIT_STORAGE=memory
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql://user:password@localhost:5432/arboris
EMAIL_PROVIDER=smtp
EMAIL_FROM="Arboris.X <sender@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@gmail.com
SMTP_PASSWORD=Secret
GMAIL_CLIENT_ID=Secret
GMAIL_CLIENT_SECRET=Secret
GMAIL_REFRESH_TOKEN=Secret
GMAIL_SENDER_EMAIL=Secret
OTP_SECRET=generate-a-random-secret-of-at-least-32-bytes
TRUSTED_DEVICE_ENABLED=false
TRUSTED_DEVICE_DAYS=30